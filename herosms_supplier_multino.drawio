        <!-- HeroSMS -->
        <mxCell id="herosms" value="HeroSMS Platform&#xa;(internet)&#xa;&#xa;─────────────&#xa;GET_SERVICES ──►&#xa;GET_NUMBER ──►&#xa;FINISH_ACTIVATION ──►&#xa;◄── PUSH_SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="55" y="150" width="230" height="220" as="geometry"/>
        </mxCell>

        <!-- Cloudflare Tunnel -->
        <mxCell id="cloudflare" value="Cloudflare Tunnel&#xa;&#xa;cloudflared&#xa;&#xa;supplier.seudominio.com&#xa;→ localhost:8000&#xa;&#xa;(gratuito, sem IP fixo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="355" y="175" width="220" height="180" as="geometry"/>
        </mxCell>

        <!-- Central API -->
        <mxCell id="central" value="Central API  —  192.168.1.100 : 8000&#xa;FastAPI&#xa;&#xa;Endpoints HeroSMS:&#xa;  GET_SERVICES  (agrega /status dos nós)&#xa;  GET_NUMBER    (chama POST /reserve no nó)&#xa;  FINISH_ACTIVATION (chama POST /release)&#xa;&#xa;Recebe POST /otps dos nós&#xa;Chama PUSH_SMS → HeroSMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="660" y="95" width="420" height="280" as="geometry"/>
        </mxCell>

        <!-- DB -->
