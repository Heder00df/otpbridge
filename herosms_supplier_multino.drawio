        <!-- Legend -->
        <mxCell id="legend" value="Legenda&#xa;&#xa;Azul:    HeroSMS (internet)&#xa;Laranja: Cloudflare Tunnel&#xa;Verde:   Central API + PostgreSQL&#xa;Vermelho: Nós (PCs com modems)&#xa;&#xa;Setas sólidas:  Central chama nó (RPC direto)&#xa;Setas tracejadas: Nó reporta ao Central&#xa;&#xa;Todos os nós têm IP fixo interno.&#xa;Apenas o Central é exposto via Cloudflare." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="1290" y="470" width="560" height="280" as="geometry"/>
        </mxCell>

        <!-- Flow note -->
        <mxCell id="flownote" value="Fluxo GET_NUMBER:&#xa;HeroSMS → Cloudflare → Central → GET /status (todos os nós) → seleciona nó com mais folga → POST /reserve → retorna número&#xa;&#xa;Fluxo OTP entregue:&#xa;Modem recebe SMS/voz → nó extrai código → POST /otps → Central → PUSH_SMS → HeroSMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="55" y="900" width="1200" height="100" as="geometry"/>
        </mxCell>

